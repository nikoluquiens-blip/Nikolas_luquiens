# Copier ce fichier en .env.local pour le dev local (jamais commité — voir .gitignore).

# Clé d'accès Web3Forms — volontairement SANS préfixe NEXT_PUBLIC_.
# Elle n'est lue que côté serveur, dans app/api/contact/route.ts.
# Récupérable sur https://web3forms.com après création du formulaire.
WEB3FORMS_KEY=

# URL publique du site, utilisée pour les métadonnées SEO (sitemap, OpenGraph...).
# Peut rester vide en local : app/layout.tsx retombe sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
